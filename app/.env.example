# Base de données (SQLite en dev — utiliser PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# URL publique du site (liens d'annulation, callback OAuth, .ics)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Accès admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changez-moi"
# Secret aléatoire pour signer les sessions admin (openssl rand -hex 32)
AUTH_SECRET="remplacez-par-un-secret-aleatoire"

# Google (Calendar OAuth + Places/Geocoding)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# SMS — Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="Les Jardins Verts <rdv@votredomaine.fr>"

# Meta Pixel (tracking conversions)
NEXT_PUBLIC_META_PIXEL_ID=""

# Secret protégeant la route cron des rappels
CRON_SECRET="remplacez-par-un-secret"
