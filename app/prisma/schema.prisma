// Prisma schema — PostgreSQL (Neon, Supabase, ou local).
// Pour du dev rapide sans Postgres : provider = "sqlite" et DATABASE_URL="file:./dev.db".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Réglages globaux (ligne unique, id = "main").
// Les champs *Json contiennent du JSON sérialisé (compatibilité SQLite).
model Settings {
  id                String   @id @default("main")
  companyName       String   @default("Arboris Paysage")
  companyPhone      String   @default("06 14 31 00 02")
  companyEmail      String   @default("contact@example.com")
  baseAddress       String   @default("4 place Barbacane, 34360 Saint-Chinian")
  basePostalCode    String   @default("34360")
  logoUrl           String   @default("")
  primaryColor      String   @default("#347030")
  // "postal" = liste de codes postaux, "radius" = rayon km autour de baseAddress
  zoneMode          String   @default("postal")
  postalCodesJson   String   @default("[\"34\"]")
  radiusKm          Int      @default(30)
  baseLat           Float?
  baseLng           Float?
  visitDurationMin  Int      @default(30)
  bufferMin         Int      @default(15)
  minNoticeHours    Int      @default(12)
  maxDaysAhead      Int      @default(21)
  // Horaires d'ouverture par jour: {"1":{"enabled":true,"start":"08:00","end":"18:00"}, ...} (1 = lundi)
  openingHoursJson  String   @default("")
  // Rendez-vous chantier (2e type) : durée + horaires propres (commencent le matin à 8h)
  chantierEnabled     Boolean @default(true)
  chantierDurationMin Int     @default(120)
  chantierHoursJson   String  @default("")
  // Congés / indisponibilités: [{"from":"2026-08-01","to":"2026-08-15","label":"Congés"}]
  daysOffJson       String   @default("[]")
  // Alerte au gérant à chaque nouvelle réservation (email et/ou SMS).
  // Destinataires vides = companyEmail / companyPhone.
  notifyOwnerEmail  Boolean  @default(true)
  notifyOwnerSms    Boolean  @default(false)
  ownerEmail        String   @default("")
  ownerPhone        String   @default("")
  // Adresse expéditrice des emails (« Arboris Paysage <contact@arborispaysage.eu> »).
  // Doit appartenir à un domaine vérifié chez Resend, sinon seuls les emails
  // adressés au propriétaire du compte Resend partent. Vide = repli sur
  // EMAIL_FROM, puis sur l'adresse d'essai de Resend.
  emailFrom         String   @default("")
  // Ne proposer que les créneaux couverts par un pro disponible :
  // "off" = jamais, "chantier" = chantiers seulement, "tous" = devis + chantiers.
  // Sécurité : si aucun pro n'a déclaré la moindre disponibilité, le filtre est
  // ignoré (sinon le site ne proposerait plus rien).
  proFilterMode     String   @default("chantier")
  // Modèles de messages ({{prenom}}, {{date}}, {{heure}}, {{adresse}}, {{entreprise}}, {{telephone}}, {{lien_annulation}})
  smsConfirmation   String   @default("")
  smsReminder24h    String   @default("")
  smsReminder1h     String   @default("")
  emailSubject      String   @default("")
  emailBody         String   @default("")
  // Publicités Meta : pixel, connexion du compte et récupération des leads.
  // Les jetons ne sont jamais renvoyés au navigateur.
  metaPixelId       String   @default("")
  metaAppId         String   @default("")
  metaAppSecret     String   @default("")
  metaUserToken     String   @default("")
  metaPageId        String   @default("")
  metaPageName      String   @default("")
  metaPageToken     String   @default("")
  // Jeton de vérification à recopier dans le tableau de bord Meta
  metaVerifyToken   String   @default("")
  metaLeadsEnabled  Boolean  @default(true)
  metaConnectedAt   DateTime?
  // Connexion Google Calendar (OAuth 2.0)
  googleRefreshToken String  @default("")
  googleAccessToken  String  @default("")
  googleTokenExpiry  DateTime?
  googleCalendarId   String  @default("primary")
  googleEmail        String  @default("")
  updatedAt         DateTime @updatedAt
}

// Secteur d'exploitation (Bordeaux, Béziers…). Sert à trois choses :
//   1. la zone d'intervention — un client est couvert si AU MOINS UNE agence
//      le couvre (préfixe de code postal OU rayon autour de l'agence) ;
//   2. le regroupement des paysagistes pour les agendas d'équipe ;
//   3. le filtrage des vues du gérant.
// Tant qu'aucune agence n'existe, l'application retombe sur la zone unique
// historique décrite dans Settings — rien ne casse pour l'existant.
model Agence {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  nom             String
  // Couleur d'identification dans les agendas
  couleur         String   @default("#347030")
  address         String   @default("")
  postalCode      String   @default("")
  city            String   @default("")
  lat             Float?
  lng             Float?
  radiusKm        Int      @default(30)
  // Préfixes ou codes postaux couverts : ["33","40"] — "33" couvre toute la Gironde
  postalCodesJson String   @default("[]")
  actif           Boolean  @default(true)
  ordre           Int      @default(0)
  pros            Pro[]
  contacts        Contact[]
}

// « Tous les clients » : la base de contacts exhaustive. Tout ce qui entre —
// réservation, formulaire, publicité, appel noté à la main — crée ou retrouve
// un contact. C'est la mémoire de l'entreprise, indépendamment de ce que la
// demande est devenue.
model Contact {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  firstName    String   @default("")
  lastName     String   @default("")
  // Téléphone normalisé (chiffres uniquement) : clé de dédoublonnage principale.
  phone        String   @default("")
  phoneKey     String   @default("")
  email        String   @default("")
  address      String   @default("")
  postalCode   String   @default("")
  city         String   @default("")
  // web | manual | meta | phone | recommandation
  origine      String   @default("web")
  agenceId     String?
  agence       Agence?  @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  notes        String   @default("")
  bookings     Booking[]
  interactions Interaction[]

  @@index([phoneKey])
  @@index([email])
}

// Journal des échanges d'un contact : appels, emails, SMS, notes libres.
model Interaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // appel | email | sms | note | rdv | devis
  type      String   @default("note")
  // entrant | sortant | interne
  sens      String   @default("interne")
  contenu   String   @default("")
  // Qui a saisi : "gerant", ou le nom d'un pro. Vide = automatique.
  auteur    String   @default("")

  @@index([contactId, createdAt])
}

model Booking {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  // Coordonnées optionnelles : un devis créé à la main peut être incomplet.
  firstName      String    @default("")
  lastName       String    @default("")
  phone          String    @default("")
  email          String    @default("")
  address        String    @default("")
  postalCode     String    @default("")
  city           String    @default("")
  lat            Float?
  lng            Float?
  // Fiche client de la base globale. Les coordonnées ci-dessus restent portées
  // par le RDV (adresse du chantier, qui peut différer de celle du contact).
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  kind           String    @default("devis") // devis | chantier
  // web = réservé sur le site ; manual = créé à la main par le gérant
  source         String    @default("web")
  // Chantier multi-jours : les RDV d'un même groupe partagent le groupId
  // (= id du RDV principal, qui porte le lien d'annulation et les photos).
  groupId        String    @default("")
  projectType    String    @default("autre") // entretien | taille_haie | debroussaillage | contrat_annuel | autre
  description    String    @default("")
  // Nulles pour un devis manuel pas encore planifié (« sans date »)
  startAt        DateTime?
  endAt          DateTime?
  status         String    @default("a_faire") // a_faire | devis_envoye | gagne | perdu | annule
  // Chantier : professionnel attribué automatiquement (le plus proche disponible).
  // Null = « à attribuer » (aucun pro éligible) — le gérant est alerté.
  proId          String?
  pro            Pro?      @relation(fields: [proId], references: [id], onDelete: SetNull)
  // Pros s'étant désistés sur ce RDV : on ne le leur repropose pas.
  declinedProsJson String  @default("[]")
  cancelToken    String    @unique @default(cuid())
  googleEventId  String    @default("")
  reminder24Sent Boolean   @default(false)
  reminder1hSent Boolean   @default(false)
  cancelledAt    DateTime?
  photos         Photo[]
}

model Photo {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Data URL base64 (MVP). En production : URL S3/Cloudinary.
  dataUrl   String
}

// Photos de réalisations affichées sur la landing (gérées depuis l'admin)
model GalleryPhoto {
  id      String @id @default(cuid())
  sort    Int    @default(0)
  // Data URL base64 (MVP). En production : URL S3/Cloudinary.
  dataUrl String
}

// Professionnels (équipe / sous-traitants) qui déclarent leurs disponibilités.
// Inscription libre (email + mot de passe). Inspiré des applis de garde pompiers.
model Pro {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String   @default("")
  // Adresse de départ (secteur) demandée à l'inscription
  baseAddress    String   @default("")
  baseCity       String   @default("")
  basePostalCode String   @default("")
  radiusKm       Int      @default(30)
  // Secteur de rattachement (agenda d'équipe). Null = non rattaché.
  agenceId       String?
  agence         Agence?  @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  // Dernier onglet ouvert dans « Mes disponibilités » (disponible_devis |
  // disponible_chantier). N'a plus d'effet sur les attributions : la
  // disponibilité découle uniquement de datesJson / devisDispoJson.
  status         String   @default("disponible_chantier")
  // Nombre de journées disponibles annoncées
  availableDays  Int      @default(0)
  // Dates disponibles : ["2026-08-12","2026-08-13",...]
  datesJson      String   @default("[]")
  // Créneaux devis validés (fin de journée, pas de 30 min) : ["18:00","18:30",...]
  // (ancien format global — conservé pour compatibilité, plus utilisé par l'UI)
  devisSlotsJson String   @default("[]")
  // Créneaux devis PAR JOUR : {"2026-08-13":["10:00","10:30","17:00"], ...}
  // C'est ce planning qui alimente les créneaux proposés aux clients (option B).
  devisDispoJson String   @default("{}")
  note           String   @default("")
  // Réinitialisation de mot de passe (lien email valable 1 h)
  resetToken     String   @default("")
  resetExpiry    DateTime?
  updatedAt      DateTime @updatedAt
  workEntries    WorkEntry[]
  bookings       Booking[]
}

// Pointage terrain d'un professionnel : une ligne par jour (heure de Paris).
// Le gérant consulte et valide les journées dans /admin/terrain.
model WorkEntry {
  id        String   @id @default(cuid())
  proId     String
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  date      String // AAAA-MM-JJ
  arrival   String   @default("") // HH:mm
  departure String   @default("") // HH:mm
  // Photos du chantier prises par le pro (data URLs JSON, 4 max chacune)
  photosBeforeJson String @default("[]")
  photosAfterJson  String @default("[]")
  validated Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([proId, date])
}

// Comptes particuliers (clients). La réservation reste possible sans compte ;
// le compte permet de retrouver et gérer ses rendez-vous (rattachés par email).
model Client {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  name         String
  email        String   @unique
  passwordHash String
  phone        String   @default("")
  // Adresse enregistrée à l'inscription : pré-remplit les réservations suivantes
  address      String   @default("")
  postalCode   String   @default("")
  city         String   @default("")
  // Réinitialisation de mot de passe (lien email valable 1 h)
  resetToken   String   @default("")
  resetExpiry  DateTime?
}

// Documents commerciaux du gérant : devis chiffrés et factures, avec lignes
// de prestations (itemsJson) et numérotation automatique (D-2026-001…).
model Document {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  type          String // devis | facture
  number        String   @unique
  date          String // AAAA-MM-JJ (date d'émission)
  clientName    String   @default("")
  clientAddress String   @default("")
  clientEmail   String   @default("")
  clientPhone   String   @default("")
  // [{"label":"Taille de haie","qty":1,"unit":"forfait","unitPrice":250}]
  itemsJson     String   @default("[]")
  vatRate       Float    @default(20) // 0 = TVA non applicable (art. 293 B CGI)
  notes         String   @default("")
  // devis : brouillon | envoye | accepte | refuse — facture : a_payer | payee
  status        String   @default("brouillon")
  updatedAt     DateTime @updatedAt
}

// Prospects : formulaire de contact hors zone (source "site") ou
// formulaire publicitaire Facebook/Instagram (source "meta").
model Lead {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String
  phone      String
  email      String   @default("")
  postalCode String
  message    String   @default("")
  source     String   @default("site") // site | meta
  // Identifiant du lead chez Meta : sert à écarter les doublons (webhook + import).
  // Simple index, pas de contrainte d'unicité : `prisma db push` refuse d'ajouter
  // une contrainte unique sans confirmation, ce qui bloquerait le déploiement.
  externalId String?
  formName   String   @default("")
  adName     String   @default("")
  campaign   String   @default("")
  // Réponses brutes du formulaire Meta (champs personnalisés inclus)
  rawJson    String   @default("")
  handled    Boolean  @default(false)

  @@index([externalId])
}
