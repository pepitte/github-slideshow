// Prisma schema — PostgreSQL (Neon, Supabase, ou local).
// Pour du dev rapide sans Postgres : provider = "sqlite" et DATABASE_URL="file:./dev.db".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Réglages globaux (ligne unique, id = "main").
// Les champs *Json contiennent du JSON sérialisé (compatibilité SQLite).
model Settings {
  id                String   @id @default("main")
  companyName       String   @default("Arboris Paysage")
  companyPhone      String   @default("06 14 31 00 02")
  companyEmail      String   @default("contact@example.com")
  baseAddress       String   @default("4 place Barbacane, 34360 Saint-Chinian")
  basePostalCode    String   @default("34360")
  logoUrl           String   @default("")
  primaryColor      String   @default("#347030")
  // "postal" = liste de codes postaux, "radius" = rayon km autour de baseAddress
  zoneMode          String   @default("postal")
  postalCodesJson   String   @default("[\"34\"]")
  radiusKm          Int      @default(30)
  baseLat           Float?
  baseLng           Float?
  visitDurationMin  Int      @default(30)
  bufferMin         Int      @default(15)
  minNoticeHours    Int      @default(12)
  maxDaysAhead      Int      @default(21)
  // Horaires d'ouverture par jour: {"1":{"enabled":true,"start":"08:00","end":"18:00"}, ...} (1 = lundi)
  openingHoursJson  String   @default("")
  // Rendez-vous chantier (2e type) : durée + horaires propres (commencent le matin à 8h)
  chantierEnabled     Boolean @default(true)
  chantierDurationMin Int     @default(120)
  chantierHoursJson   String  @default("")
  // Congés / indisponibilités: [{"from":"2026-08-01","to":"2026-08-15","label":"Congés"}]
  daysOffJson       String   @default("[]")
  // Modèles de messages ({{prenom}}, {{date}}, {{heure}}, {{adresse}}, {{entreprise}}, {{telephone}}, {{lien_annulation}})
  smsConfirmation   String   @default("")
  smsReminder24h    String   @default("")
  smsReminder1h     String   @default("")
  emailSubject      String   @default("")
  emailBody         String   @default("")
  // Connexion Google Calendar (OAuth 2.0)
  googleRefreshToken String  @default("")
  googleAccessToken  String  @default("")
  googleTokenExpiry  DateTime?
  googleCalendarId   String  @default("primary")
  googleEmail        String  @default("")
  updatedAt         DateTime @updatedAt
}

model Booking {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  // Coordonnées optionnelles : un devis créé à la main peut être incomplet.
  firstName      String    @default("")
  lastName       String    @default("")
  phone          String    @default("")
  email          String    @default("")
  address        String    @default("")
  postalCode     String    @default("")
  city           String    @default("")
  lat            Float?
  lng            Float?
  kind           String    @default("devis") // devis | chantier
  // web = réservé sur le site ; manual = créé à la main par le gérant
  source         String    @default("web")
  // Chantier multi-jours : les RDV d'un même groupe partagent le groupId
  // (= id du RDV principal, qui porte le lien d'annulation et les photos).
  groupId        String    @default("")
  projectType    String    @default("autre") // entretien | taille_haie | debroussaillage | contrat_annuel | autre
  description    String    @default("")
  // Nulles pour un devis manuel pas encore planifié (« sans date »)
  startAt        DateTime?
  endAt          DateTime?
  status         String    @default("a_faire") // a_faire | devis_envoye | gagne | perdu | annule
  cancelToken    String    @unique @default(cuid())
  googleEventId  String    @default("")
  reminder24Sent Boolean   @default(false)
  reminder1hSent Boolean   @default(false)
  cancelledAt    DateTime?
  photos         Photo[]
}

model Photo {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Data URL base64 (MVP). En production : URL S3/Cloudinary.
  dataUrl   String
}

// Photos de réalisations affichées sur la landing (gérées depuis l'admin)
model GalleryPhoto {
  id      String @id @default(cuid())
  sort    Int    @default(0)
  // Data URL base64 (MVP). En production : URL S3/Cloudinary.
  dataUrl String
}

// Professionnels (équipe / sous-traitants) qui déclarent leurs disponibilités.
// Inscription libre (email + mot de passe). Inspiré des applis de garde pompiers.
model Pro {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String   @default("")
  // Adresse de départ (secteur) demandée à l'inscription
  baseAddress    String   @default("")
  baseCity       String   @default("")
  basePostalCode String   @default("")
  radiusKm       Int      @default(30)
  // disponible_devis | disponible_chantier | sous_confirmation | indisponible
  status         String   @default("indisponible")
  // Nombre de journées disponibles annoncées
  availableDays  Int      @default(0)
  // Dates disponibles : ["2026-08-12","2026-08-13",...]
  datesJson      String   @default("[]")
  // Créneaux devis validés (fin de journée, pas de 30 min) : ["18:00","18:30",...]
  devisSlotsJson String   @default("[]")
  note           String   @default("")
  // Réinitialisation de mot de passe (lien email valable 1 h)
  resetToken     String   @default("")
  resetExpiry    DateTime?
  updatedAt      DateTime @updatedAt
  workEntries    WorkEntry[]
}

// Pointage terrain d'un professionnel : une ligne par jour (heure de Paris).
// Le gérant consulte et valide les journées dans /admin/terrain.
model WorkEntry {
  id        String   @id @default(cuid())
  proId     String
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  date      String // AAAA-MM-JJ
  arrival   String   @default("") // HH:mm
  departure String   @default("") // HH:mm
  // Photos du chantier prises par le pro (data URLs JSON, 4 max chacune)
  photosBeforeJson String @default("[]")
  photosAfterJson  String @default("[]")
  validated Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([proId, date])
}

// Comptes particuliers (clients). La réservation reste possible sans compte ;
// le compte permet de retrouver et gérer ses rendez-vous (rattachés par email).
model Client {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  name         String
  email        String   @unique
  passwordHash String
  phone        String   @default("")
  // Adresse enregistrée à l'inscription : pré-remplit les réservations suivantes
  address      String   @default("")
  postalCode   String   @default("")
  city         String   @default("")
  // Réinitialisation de mot de passe (lien email valable 1 h)
  resetToken   String   @default("")
  resetExpiry  DateTime?
}

// Prospects hors zone d'intervention (formulaire de contact)
model Lead {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String
  phone      String
  email      String   @default("")
  postalCode String
  message    String   @default("")
}
